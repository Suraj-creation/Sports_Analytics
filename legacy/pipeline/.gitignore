# ── Match data & pipeline outputs ───────────────────────────────────────
# Every one of these is generated by running the pipeline against a real
# match video (shuttle CSVs, rally CSVs, court.json, annotated video,
# reports, etc) -- not source code. Excluded so the repo stays just the
# pipeline itself.
IntegrationTest/
output_shuttle/
seg_*/
SmokeTest_T1/
Test1_Full_rev/
Test1_part1/
Test1_part2/
Test3_test1/
Test_c1/
Test_c2/
testcase*/
video_input/

# Any video file, wherever it ends up
*.mp4
*.mov
*.mkv
*.avi

# ── Trained model weights ───────────────────────────────────────────────
# Binary weight files -- yolo11x.pt and ckpts/TrackNet_best.pt exceed
# GitHub's 100MB per-file push limit outright; the rest are excluded for
# consistency (all "inputs the pipeline needs", not code). See README for
# where to obtain each one.
yolo11x.pt
ckpts/
analysis/cnn_rally_end/models/*.pt
win_predictor/models/*.pt
win_predictor/models/*.pkl

# ── webapp runtime state / secrets / build artifacts ────────────────────
webapp/app.db
webapp/.secret_key
webapp/uploads/
webapp/frontend/node_modules/
webapp/frontend/dist/
# Superseded by webapp/frontend/ (the React app) -- kept on disk locally
# as a rollback reference, not part of this repo.
webapp/static/

# ── general ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
*.log

# From origin/badminton-rally-detection (V-JEPA experiment data)
vjepa_setup/dataset/clips/
