    "profile_yaml": "# Primary target: Ubuntu + NVIDIA RTX 4000 Ada (20 GB). Report Option B (multi-rate, cascaded,\n# event-triggered). All model choices are re-validated by the Phase-1 benchmark (docs/benchmarks).\ndescription: RTX 4000 Ada \u2014 TensorRT FP16, multi-rate, event-triggered specialists\ndevice: cuda\nanalysis_height: 720\nchunk_frames: 64          # multiple of the TrackNet window (8)\nlead_buffer_s: 5.0\n\nshuttle:                  # VOD: TrackNetV3, non-overlapping 8-frame windows, per-shot median bg\n  model: tracknetv3\n  backend: torch-cuda\n  precision: fp16\n  batch: 4                # windows per forward\n  input_size: [512, 288]\n  params: {seq_len: 8, bg_mode: concat, threshold: 0.5, step: 8}\nshuttle_live:             # causal model for live sources (E3 decides; balltrack is the default)\n  model: racketvision_balltrack\n  backend: torch-cuda\n  precision: fp16\nshuttle_second_opinion:   # disagreement oracle on low-confidence windows\n  model: wasb_badminton\n  backend: torch-cuda\n  precision: fp16\nplayer_detector:\n  model: rfdetr_small\n  backend: onnx-cuda\n  precision: fp16\n  input_size: [512, 512]\n  params: {score_threshold: 0.35, court_roi: true}\nplayer_reid:\n  model: osnet_ain_x0_25\n  backend: torch-cuda\n  precision: fp32\n  params: {retention_seconds: 8}\npose:\n  model: rtmpose_m_body7\n  backend: onnx-cuda\n  precision: fp16\n  batch: 2\n  input_size: [192, 256]\nracket:\n  model: racket_geometry_v1\n  backend: opencv-cpu\n  precision: fp32\n# The active baseline is the rule classifier, not an installed BST checkpoint.\ncomponents:\n  stroke: {implementation: stroke-rules-v0, model: none, backend: none}\nstroke: {model: none, backend: none}\ncontact:\n  model: contact_fusion_v2  # deterministic, optional observed racket support\n  backend: none\nocr:\n  model: rapidocr_v4\n  backend: onnx-cuda\n\ndetector_rates: {in_play: 2, idle: 6, replay: 0}\npose_rates:     {in_play: 1, idle: 6, replay: 0}\nshuttle_rates:  {in_play: 1, idle: 1, replay: 0}\nocr_every_s: 1.0\ncourt_verify_every_s: 2.0\nescalation_budget: 0.15\nracket_window: 6\n",
    "proxy_height": 720
  },
