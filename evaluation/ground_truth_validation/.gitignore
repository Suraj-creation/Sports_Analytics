# Retain raw evaluation evidence locally; publish tools and human-readable reports.
*.json
*.jsonl
*.png
*.jpg
*.jpeg
*.npz
*.msgpack
*.csv
*.txt
*.patch
*.executed
__pycache__/
orchestration/inherited_authored_files/
orchestration/pre_fix_source_backup/
dataset_inventory/reference_documents/
test_*/references/
test_*/baseline_v1
test_*/improved_v1
test_*/logs/

# Retained run/source snapshots are local reproducibility evidence, not another
# authored package or worktree. Keep canonical tools, tests and Markdown in Git.
test_*/diagnostics/**/cache_snapshots/
test_*/diagnostics/**/candidate_source/
test_*/diagnostics/**/baseline_source/
test_*/diagnostics/**/original_source/
test_*/**/executed_*.py
test_*/**/executed_*/
test_*/diagnostics/ocr_pairing/historical_parser_*.py
test_*/fixes/pre_fix_source/
test_*/fixes/semantic_effect_evidence/
test_*/regression/*_semantic_regression_v*
test_*/retention/

# Preserve investigation snapshots and third-party source evidence locally;
# publish canonical tools/tests and authored human-readable reports.
component_evaluations/**/birth_only_source_snapshot/
component_evaluations/**/final_candidate_source*/
component_evaluations/**/primary_sources/
component_evaluations/**/executed*/
failure_cases/**/source_snapshots/
regression_tests/**/executed*/

# Generated execution evidence stays available locally, outside source publication.
*.sqlite
*.sqlite-*
*.xml
*.source
*.diff
*.html
*.yaml
regression_tests/**/execution.lock
component_evaluations/**/source_snapshots/
regression_tests/**/source_snapshots/
